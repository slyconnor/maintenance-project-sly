{
  "name": "maintenance-manager-cloudflare-v5-8",
  "private": true,
  "version": "5.8.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check src/index.js && node --check public/app.js && node --check public/admin.js && node --check public/pi.js && node --check public/request.js",
